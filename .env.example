SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/careerhub
DEV_SHOW_RESET_LINK=0
REQUIRE_EMAIL_VERIFICATION=1
SESSION_COOKIE_SECURE=1
REMEMBER_COOKIE_SECURE=1
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
MAX_CONTENT_LENGTH=12582912
MAX_RESUME_SIZE=4194304
MAX_PHOTO_SIZE=2097152
APP_BASE_URL=https://your-domain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-user
SMTP_PASSWORD=your-password
SMTP_USE_TLS=1
MAIL_FROM=no-reply@your-domain.com
AUTO_CREATE_DB=0
TRUST_PROXY=1
AUTO_APPROVE_RECRUITER_COMPANIES=0
HEALTHCHECK_ENABLED=1
MAX_SEARCH_RESULTS=500
